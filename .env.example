# Porta do Chrome com Remote Debugging (padrão: 9222)
CHROME_DEBUG_PORT=9222

# Credenciais do Supabase (as mesmas usadas no NSMusic)
SUPABASE_URL=https://sua-url-supabase.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Intervalo em milissegundos para polling de novos pedidos no modo watch (padrão: 5000 = 5 segundos)
POLL_INTERVAL_MS=5000

# Nome do modelo padrão no Suno (v3.5, v4, etc.)
SUNO_MODEL_VERSION=v4
